<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/com.android.settings"
    android:key="dynamic_island_settings"
    android:title="@string/dynamic_island_title">

    <com.android.settings.custom.preference.SystemSettingMainSwitchPreference
        android:key="status_bar_show_dynamic_island"
        android:title="@string/dynamic_island_title"
        android:defaultValue="true" />

    <PreferenceCategory
        android:key="dynamic_island_customization_category"
        android:title="@string/dynamic_island_customization_title">

        <com.android.settings.custom.preference.SystemSettingSeekBarPreference
            android:key="status_bar_dynamic_island_width_scale"
            android:title="@string/dynamic_island_width_scale_title"
            android:min="70"
            android:max="140"
            app:units="%"
            android:defaultValue="100"
            android:dependency="status_bar_show_dynamic_island" />

        <com.android.settings.custom.preference.SystemSettingSeekBarPreference
            android:key="status_bar_dynamic_island_height_scale"
            android:title="@string/dynamic_island_height_scale_title"
            android:min="70"
            android:max="140"
            app:units="%"
            android:defaultValue="100"
            android:dependency="status_bar_show_dynamic_island" />

        <com.android.settings.custom.preference.SystemSettingListPreference
            android:key="status_bar_dynamic_island_popup_color_mode"
            android:title="@string/dynamic_island_popup_color_mode_title"
            android:summary="@string/dynamic_island_popup_color_mode_summary"
            android:entries="@array/dynamic_island_popup_color_mode_entries"
            android:entryValues="@array/dynamic_island_popup_color_mode_values"
            android:defaultValue="0"
            android:dependency="status_bar_show_dynamic_island" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_lockscreen"
            android:title="@string/dynamic_island_lockscreen_title"
            android:summary="@string/dynamic_island_lockscreen_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="dynamic_island_features_category"
        android:title="@string/dynamic_island_features_title">

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_media_controls"
            android:title="@string/dynamic_island_media_controls_title"
            android:summary="@string/dynamic_island_media_controls_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="true" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_screen_recording"
            android:title="@string/dynamic_island_screen_recording_title"
            android:summary="@string/dynamic_island_screen_recording_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="true" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_alarms"
            android:title="@string/dynamic_island_alarms_title"
            android:summary="@string/dynamic_island_alarms_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="true" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_flashlight"
            android:title="@string/dynamic_island_flashlight_title"
            android:summary="@string/dynamic_island_flashlight_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="true" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_stopwatch"
            android:title="@string/dynamic_island_stopwatch_title"
            android:summary="@string/dynamic_island_stopwatch_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="true" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_live_scores"
            android:title="@string/dynamic_island_live_scores_title"
            android:summary="@string/dynamic_island_live_scores_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="true" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_lyrics"
            android:title="@string/dynamic_island_lyrics_title"
            android:summary="@string/dynamic_island_lyrics_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="dynamic_island_events_category"
        android:title="@string/dynamic_island_events_title">

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_battery"
            android:title="@string/dynamic_island_battery_title"
            android:summary="@string/dynamic_island_battery_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="false" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_unlock"
            android:title="@string/dynamic_island_unlock_title"
            android:summary="@string/dynamic_island_unlock_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="false" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_bluetooth"
            android:title="@string/dynamic_island_bluetooth_title"
            android:summary="@string/dynamic_island_bluetooth_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="false" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_calls"
            android:title="@string/dynamic_island_calls_title"
            android:summary="@string/dynamic_island_calls_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="false" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_notifications"
            android:title="@string/dynamic_island_notifications_title"
            android:summary="@string/dynamic_island_notifications_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="false" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_ongoing_activities"
            android:title="@string/dynamic_island_ongoing_activities_title"
            android:summary="@string/dynamic_island_ongoing_activities_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="false" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_hotspot"
            android:title="@string/dynamic_island_hotspot_title"
            android:summary="@string/dynamic_island_hotspot_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="false" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_vpn"
            android:title="@string/dynamic_island_vpn_title"
            android:summary="@string/dynamic_island_vpn_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="false" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_ringer"
            android:title="@string/dynamic_island_ringer_title"
            android:summary="@string/dynamic_island_ringer_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="false" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_clipboard"
            android:title="@string/dynamic_island_clipboard_title"
            android:summary="@string/dynamic_island_clipboard_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="false" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_timer"
            android:title="@string/dynamic_island_timer_title"
            android:summary="@string/dynamic_island_timer_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="false" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_audio_recording"
            android:title="@string/dynamic_island_audio_recording_title"
            android:summary="@string/dynamic_island_audio_recording_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="false" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_now_playing"
            android:title="@string/dynamic_island_now_playing_title"
            android:summary="@string/dynamic_island_now_playing_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="false" />

        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_recent_apps"
            android:title="@string/dynamic_island_recent_apps_title"
            android:summary="@string/dynamic_island_recent_apps_summary"
            android:dependency="status_bar_show_dynamic_island"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="dynamic_island_footer_category"
        android:title="@string/dynamic_island_footer_title">

        <com.android.settingslib.widget.FooterPreference
            android:key="dynamic_island_footer"
            android:title="@string/dynamic_island_intro"
            android:icon="@drawable/ic_info_outline_24dp"
            android:selectable="false" />

    </PreferenceCategory>

</PreferenceScreen>
