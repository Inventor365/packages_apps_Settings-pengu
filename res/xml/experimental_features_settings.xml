<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="experimental_features_settings"
    android:title="@string/experimental_features_title">

    <com.android.settings.custom.preference.SystemSettingSwitchPreference
        android:key="ls_media_expand"
        android:title="@string/ls_media_expand_title"
        android:summary="@string/ls_media_expand_summary"
        android:defaultValue="false" />

    <com.android.settings.custom.preference.SystemSettingSwitchPreference
        android:key="ls_media_motion_art"
        android:title="@string/ls_media_motion_art_title"
        android:summary="@string/ls_media_motion_art_summary"
        android:dependency="ls_media_expand"
        android:defaultValue="false" />

    <com.android.settings.custom.preference.SecureSettingSwitchPreference
        android:key="qs_oneui_experimental"
        android:title="@string/qs_oneui_title"
        android:summary="@string/qs_oneui_summary"
        android:defaultValue="false" />

    <com.android.settings.custom.preference.SystemSettingSwitchPreference
        android:key="back_to_app_indicator"
        android:title="@string/back_to_app_indicator_title"
        android:summary="@string/back_to_app_indicator_summary"
        android:defaultValue="false" />

    <com.android.settings.custom.preference.SecureSettingSwitchPreference
        android:key="recents_frequent_apps"
        android:title="@string/recents_frequent_apps_title"
        android:summary="@string/recents_frequent_apps_summary"
        android:defaultValue="false" />

    <com.android.settings.custom.preference.SecureSettingSwitchPreference
        android:key="depth_wallpaper_floating"
        android:title="@string/depth_wallpaper_floating_title"
        android:summary="@string/depth_wallpaper_floating_summary"
        android:defaultValue="false" />

    <Preference
        android:key="penguin_laboratory"
        android:title="@string/penguin_laboratory_title"
        android:summary="@string/penguin_laboratory_summary">
        <intent
            android:targetPackage="com.penguin.laboratory"
            android:targetClass="com.penguin.laboratory.LaboratoryActivity" />
    </Preference>

</PreferenceScreen>
