<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/slot_container"
    android:layout_width="@dimen/Keyguard_fp_ql_Item_view_width"
    android:layout_height="@dimen/Keyguard_fp_ql_Item_view_height"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Slot Background / Border -->
    <ImageView
        android:id="@+id/slot_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/fp_ql_slot_empty_border"
        android:contentDescription="@null" />

    <!-- Main Icon -->
    <ImageView
        android:id="@+id/slot_icon"
        android:layout_width="@dimen/ql_settings_app_size"
        android:layout_height="@dimen/ql_settings_app_size"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- Shortcut Sub-icon (small app badge in corner) -->
    <ImageView
        android:id="@+id/slot_sub_icon"
        android:layout_width="@dimen/kgd_fp_ql_shortcut_second_app_size"
        android:layout_height="@dimen/kgd_fp_ql_shortcut_second_app_size"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="2dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="@null" />

    <!-- Red delete badge (-) in edit mode -->
    <ImageView
        android:id="@+id/slot_remove_badge"
        android:layout_width="@dimen/Keyguard_fp_ql_Item_remove_size"
        android:layout_height="@dimen/Keyguard_fp_ql_Item_remove_size"
        android:layout_gravity="top|end"
        android:src="@drawable/fp_ql_setting_remove"
        android:visibility="gone"
        android:contentDescription="@string/quick_launch_cancel" />

</FrameLayout>
