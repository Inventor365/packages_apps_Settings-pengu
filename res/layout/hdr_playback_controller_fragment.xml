<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hdr_controller_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <!-- 1. Hero Summary & Behavior Explanation Card -->
        <LinearLayout
            android:id="@+id/hdr_hero_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/hdr_controller_hero_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/hdr_controller_hero_icon_circle">

                    <ImageView
                        android:id="@+id/hdr_hero_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_hdr_playback_controller"
                        android:tint="?android:attr/colorAccent"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/hdr_hero_eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hdr_playback_controller_eyebrow"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.03"
                        android:textColor="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/hdr_hero_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/hdr_playback_controller_title"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary" />

                    <TextView
                        android:id="@+id/hdr_hero_status_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:background="@drawable/hdr_controller_active_chip_bg"
                        android:text="@string/hdr_playback_status_all_default"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/colorAccent" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/hdr_hero_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/hdr_playback_controller_intro"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/hdr_hero_limitation_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/hdr_playback_controller_limitation_note"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <!-- 2. Search Input Card -->
        <LinearLayout
            android:id="@+id/hdr_search_container"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:background="@drawable/hdr_controller_item_bg_inactive">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@*android:drawable/ic_search_api_material"
                android:tint="?android:attr/textColorSecondary"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/hdr_search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="@string/hdr_playback_search_apps_hint"
                android:imeOptions="actionSearch"
                android:inputType="textFilter|textNoSuggestions"
                android:maxLines="1"
                android:singleLine="true"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary" />

            <ImageView
                android:id="@+id/hdr_search_clear"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@*android:drawable/ic_clear_material"
                android:tint="?android:attr/textColorSecondary"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                android:contentDescription="@string/hdr_playback_search_clear" />
        </LinearLayout>

        <!-- 3. Filter Chips & Reset All Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/filter_chip_all"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/hdr_controller_filter_chip_bg"
                    android:text="@string/hdr_playback_filter_all"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/hdr_controller_filter_chip_text"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/filter_chip_custom"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/hdr_controller_filter_chip_bg"
                    android:text="@string/hdr_playback_filter_custom"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/hdr_controller_filter_chip_text"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/filter_chip_sdr_only"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/hdr_controller_filter_chip_bg"
                    android:text="@string/hdr_playback_filter_restricted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/hdr_controller_filter_chip_text"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/filter_chip_hdr_allowed"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/hdr_controller_filter_chip_bg"
                    android:text="@string/hdr_playback_filter_allowed"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/hdr_controller_filter_chip_text"
                    android:clickable="true"
                    android:focusable="true" />

                <LinearLayout
                    android:id="@+id/hdr_reset_all_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/hdr_controller_button_secondary_bg"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_hdr_reset"
                        android:tint="?android:attr/colorAccent"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hdr_playback_reset_all"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/colorAccent" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- 4. Section Header -->
        <TextView
            android:id="@+id/hdr_apps_section_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"
            android:text="@string/hdr_playback_apps_section_title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/colorAccent" />

        <!-- 5. Loading / Empty state -->
        <TextView
            android:id="@+id/hdr_empty_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/hdr_playback_loading_apps"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="visible" />

        <!-- 6. Applications RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hdr_apps_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
